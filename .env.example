# KaamSetu environment variables: DOCUMENTATION ONLY.
# Copy to `.env` for local development. `.env` is git-ignored and is NEVER
# included in the deployment ZIP. In production, set these in GoDaddy's
# environment-variable settings for the Node.js app.
# Do not put real values in this file.

# --- Server ---
# Provided by GoDaddy in production. Optional locally (defaults to 3001).
PORT=3001
NODE_ENV=development
# Public origin of the app, e.g. https://your-domain.example (used for CORS in dev)
APP_ORIGIN=http://localhost:5173

# --- Supabase ---
# Safe to expose to browsers (RLS protects data). Served to the SPA at runtime.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SECRET. Server only. Bypasses RLS. Never in frontend code, Git, or the ZIP.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (SECRET, server only) ---
ANTHROPIC_API_KEY=
# Model id is configurable so it can be changed without a code change.
ANTHROPIC_MODEL=

# --- Contact form / Titan email (SECRET, server only) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
CONTACT_TO=

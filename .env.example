# KaamSetu environment variables: DOCUMENTATION ONLY.
# Copy to `.env` for local development. `.env` is git-ignored and is NEVER
# included in the deployment ZIP. In production, set these in GoDaddy's
# environment-variable settings for the Node.js app.
# Do not put real values in this file.

# --- Server ---
# Provided by GoDaddy in production. Optional locally (defaults to 3001).
PORT=3001
NODE_ENV=development
# Public origin of the app, e.g. https://your-domain.example (used for CORS in dev)
APP_ORIGIN=http://localhost:5173

# --- Supabase ---
# Safe to expose to browsers (RLS protects data). Served to the SPA at runtime.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SECRET. Server only. Bypasses RLS. Never in frontend code, Git, or the ZIP.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (SECRET, server only) ---
# Needed for "Create a job with AI". Without it the AI endpoints answer 503 ai_not_configured and everything else works.
# Claude Code's own login is NOT an application key: create one at https://console.anthropic.com and set it here.
ANTHROPIC_API_KEY=
# Model id is configurable so it can be changed without a code change. Default: claude-opus-5-5.
ANTHROPIC_MODEL=

# --- Contact form email (SMTP; SECRET, server only) ---
# Optional. Without these four, POST /api/contact answers 503 and the page shows the email address instead.
# SMTP_USER must be the full mailbox address: it is used as the From address (the visitor goes in Reply-To).
# Port 465 uses implicit TLS; any other port (e.g. 587) requires STARTTLS.
# Check the exact host/port in your mail provider's settings. Not yet verified from GoDaddy hosting (see docs/deployment-godaddy.md).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Where contact messages are delivered. Optional; defaults to info@kaamsetu.tech.
CONTACT_TO=
# Optional. Number of reverse-proxy hops to trust for per-client rate limits. Leave unset unless you have verified the platform's proxy setup.
TRUST_PROXY_HOPS=

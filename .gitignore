# Dependencies
node_modules/

# Secrets: never commit real env files. Only .env.example is tracked.
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# Build and deployment output (generated by scripts/, never hand-edited)
dist/
dist-deploy/
*.zip
*.tsbuildinfo

# Caches and tooling
.vite/
.cache/
.turbo/
coverage/
playwright-report/
test-results/

# Supabase CLI local state (migrations in supabase/migrations ARE tracked)
supabase/.temp/
supabase/.branches/

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
